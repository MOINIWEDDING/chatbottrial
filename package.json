{
  "name": "denuncias-santiago",
  "version": "1.0.0",
  "description": "Chatbot de denuncias ciudadanas (WhatsApp, Instagram, Facebook) con panel web por departamento",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "crear-usuario": "node --env-file-if-exists=.env scripts/crear-usuario.js",
    "test": "node --test \"test/**/*.test.js\"",
    "instagram": "node --env-file-if-exists=.env scripts/instagram.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOINIWEDDING/chatbottrial.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/MOINIWEDDING/chatbottrial/issues"
  },
  "homepage": "https://github.com/MOINIWEDDING/chatbottrial#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
