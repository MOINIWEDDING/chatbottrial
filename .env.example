# Copie este archivo como .env y complete los valores.
PORT=3000
# URL pública (https) donde Meta enviará los webhooks, p. ej. https://denuncias.munistgo.cl
# (en Vercel se toma sola del dominio de producción)
PUBLIC_URL=
# Contraseña del usuario "admin" que se crea en el primer arranque
ADMIN_PASSWORD=
# Base de datos: cadena de conexión de Supabase (Connect → Transaction pooler, puerto 6543).
# Sin ella se usa una base local (PGlite) en ./data/pglite, sólo para desarrollo.
# En Vercel es obligatoria (o POSTGRES_URL, si conecta Supabase desde Vercel → Storage).
DATABASE_URL=
# Opcional: certificado SSL de Supabase (Project Settings → Database → SSL Configuration)
DATABASE_CA_CERT=
# Minutos en que los mensajes siguientes del vecino se agregan a la misma denuncia
CONVERSATION_WINDOW_MINUTES=30
# Poner en false en producción para ocultar el simulador
ENABLE_SIMULATOR=true

# --- Meta (developers.facebook.com → su app) ---
META_GRAPH_VERSION=v21.0
# Texto libre que usted inventa y luego pega en la configuración del webhook en Meta
META_VERIFY_TOKEN=
# App Secret (Configuración de la app → Básica). Obligatorio en producción.
META_APP_SECRET=
# WhatsApp Cloud API: token permanente de un usuario del sistema
WHATSAPP_TOKEN=
# Token de acceso de la página de Facebook (Messenger)
FB_PAGE_ACCESS_TOKEN=
# --- Instagram ---
# Opción A (recomendada): API de Instagram con inicio de sesión de Instagram.
#   Token de la cuenta profesional (empieza con IGAA…) y clave secreta de la app de Instagram.
# Opción B: vía página de Facebook. Deje INSTAGRAM_ACCESS_TOKEN vacío y se usará FB_PAGE_ACCESS_TOKEN.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
# 'instagram' (opción A) o 'facebook' (opción B). Vacío = se detecta según el token.
INSTAGRAM_API=
