# Copie este archivo como .env y complete los valores.
PORT=3000
# URL pública (https) donde Meta enviará los webhooks, p. ej. https://denuncias.munistgo.cl
PUBLIC_URL=
# Contraseña del usuario "admin" que se crea en el primer arranque
ADMIN_PASSWORD=
DB_PATH=./data/denuncias.db
# Minutos en que los mensajes siguientes del vecino se agregan a la misma denuncia
CONVERSATION_WINDOW_MINUTES=30
# Poner en false en producción para ocultar el simulador
ENABLE_SIMULATOR=true

# --- Meta (developers.facebook.com → su app) ---
META_GRAPH_VERSION=v21.0
# Texto libre que usted inventa y luego pega en la configuración del webhook en Meta
META_VERIFY_TOKEN=
# App Secret (Configuración de la app → Básica). Obligatorio en producción.
META_APP_SECRET=
# WhatsApp Cloud API: token permanente de un usuario del sistema
WHATSAPP_TOKEN=
# Token de acceso de la página de Facebook (Messenger)
FB_PAGE_ACCESS_TOKEN=
# Instagram: si no se define, se usa el token de la página vinculada a la cuenta de Instagram
INSTAGRAM_ACCESS_TOKEN=
